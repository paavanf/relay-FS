NODE_ENV=development
PORT=4917

# MongoDB Atlas connection string (required - a replica set is needed for
# transactions, which createOrganisation and acceptInvite depend on).
# A standalone local mongod will connect fine but those two operations will
# fail with "Transaction numbers are only allowed on a replica set member".
#
# Get this from Atlas: Cluster -> Connect -> Drivers
# Remember to put the database name (/relay-dev) before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/relay-dev?retryWrites=true&w=majority

CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-different-64-char-random-string

# Shared secret for internal job endpoints - today just the reaper that lets
# go of expired swap reservations (POST /api/v1/internal/reap-expired). A
# scheduler sends it in the X-Internal-Job-Secret header; nothing in the app
# schedules the job itself. At least 32 characters, compared in constant
# time. Leave it unset and those endpoints refuse every request.
# INTERNAL_JOB_SECRET=replace-with-another-64-char-random-string

# Where links in emails point - the frontend, not the API. Password-reset,
# invite and notification links are all built from this.
#
# IN PRODUCTION THIS MUST BE THE DEPLOYED FRONTEND URL. Leave it as localhost
# and every invite you send will point people at their own machine.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email
#
# Transports are tried in this order, and the backend logs which one is active
# at startup:
#
#   1. SMTP    - if SMTP_USER and SMTP_PASS are set
#   2. Resend  - if RESEND_API_KEY is set
#   3. console - neither; links are printed to the backend console instead
#
# Leaving all of it unset is a perfectly good development setup: reset,
# invite and notification links appear in the console, prefixed
# [EMAIL DEV MODE].
# ---------------------------------------------------------------------------

# --- Option 1: SMTP (recommended without your own domain) ---
# Gmail works and will deliver to any real address. It needs an APP PASSWORD,
# not your normal password: turn on 2-factor authentication, then generate one
# at https://myaccount.google.com/apppasswords. Leave these unset to disable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password

# --- Option 2: Resend (needs a verified domain to be useful) ---
# Free API key at resend.com.
#
# IMPORTANT: the default sender below, onboarding@resend.dev, is Resend's
# SANDBOX address. It only delivers to the email address that owns the Resend
# account - every other recipient silently gets nothing. To email real users
# you must verify your own domain and set EMAIL_FROM to an address on it.
# If you do not own a domain, use SMTP above instead.
# RESEND_API_KEY=re_your_key_here
EMAIL_FROM=onboarding@resend.dev
