# frontend/.env.example
# Copy to frontend/.env (git ignores it) to change how the frontend is built.
# Vite reads these at BUILD time: change one, then rebuild (npm run build) or
# restart the dev server. Nothing here is secret - it all ends up in the
# JavaScript the browser downloads.

# Public demo mode. Set to true only for the public deployment:
#   - the login page lists the shared demo's three accounts ("Try the demo"),
#     each with a button that signs straight in
#   - the landing page's second button becomes "Try the demo"
# Leave it unset (or anything but true) for local development, where those
# accounts only exist after you run the demo seed yourself.
# The demo organisation's locked settings do not depend on this flag: the
# server refuses those changes in every build.
VITE_DEMO_MODE=false

# Where the dev server sends /api requests (npm run dev only). Defaults to
# the backend's own default port.
# VITE_API_PROXY=http://localhost:4917

# Sign-in: your Supabase project (docs/deploy/SUPABASE.md) - locally, the
# development project. Its URL and PUBLISHABLE key, both from the project's
# API settings page and both public by design. Never a secret or service
# role key: anything here is readable by every visitor, and the build
# refuses one (config/envGuard.js).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
